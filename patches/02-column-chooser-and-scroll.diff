+    <script nonce="{{ $JS_NONCE }}">
+        // Column chooser for transaction lists. Hidden columns are stored per browser.
+        (function () {
+            if (window.ffColumnChooserLoaded) {
+                return;
+            }
+            window.ffColumnChooserLoaded = true;
+            var storageKey = 'ff3.transactionList.hiddenColumns';
+
+            function load() {
+                try {
+                    var value = JSON.parse(window.localStorage.getItem(storageKey) || '[]');
+                    return Array.isArray(value) ? value : [];
+                } catch (e) {
+                    return [];
+                }
+            }
+
+            function save(hidden) {
+                try {
+                    window.localStorage.setItem(storageKey, JSON.stringify(hidden));
+                } catch (e) {
+                    // storage unavailable: the choice lasts until the page is reloaded
+                }
+            }
+
+            function apply(hidden) {
+                document.querySelectorAll('table.ff-groups-large').forEach(function (table) {
+                    var present = [];
+                    table.querySelectorAll('th[data-ff-col]').forEach(function (th) {
+                        present.push(th.dataset.ffCol);
+                    });
+                    table.querySelectorAll('[data-ff-col]').forEach(function (cell) {
+                        cell.classList.toggle('d-none', hidden.indexOf(cell.dataset.ffCol) !== -1);
+                    });
+                    table.querySelectorAll('[data-ff-span]').forEach(function (cell) {
+                        var removed = cell.dataset.ffSpan.split(',').filter(function (key) {
+                            return present.indexOf(key) !== -1 && hidden.indexOf(key) !== -1;
+                        }).length;
+                        cell.colSpan = Math.max(1, parseInt(cell.dataset.ffBase, 10) - removed);
+                    });
+                });
+                document.querySelectorAll('input[data-ff-toggle]').forEach(function (input) {
+                    input.checked = hidden.indexOf(input.dataset.ffToggle) === -1;
+                });
+            }
+
+            document.addEventListener('change', function (event) {
+                var input = event.target;
+                if (!input.matches || !input.matches('input[data-ff-toggle]')) {
+                    return;
+                }
+                var key = input.dataset.ffToggle;
+                var hidden = load().filter(function (item) {
+                    return item !== key;
+                });
+                if (!input.checked) {
+                    hidden.push(key);
+                }
+                save(hidden);
+                apply(hidden);
+            });
+
+            apply(load());
+        })();
+    </script>
     @endsection
